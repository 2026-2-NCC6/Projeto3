# Copie para .env (fica fora do git).

# URL base da API, com /api/v1 e sem barra no final. Em produção, sempre HTTPS (RNF04).
# No emulador Android, o backend local fica em http://10.0.2.2:3000.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# SÓ PARA TESTE EM BANCADA, em build de desenvolvimento: chave da raquete (32 hex, a mesma do
# segredo.h do firmware). Em build de produção esta variável é ignorada e a chave vem da API,
# entregue apenas ao dono da raquete depois do login. Nunca defina isto ao gerar o APK.
EXPO_PUBLIC_CHAVE_DISPOSITIVO_DEV=
