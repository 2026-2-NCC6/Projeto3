# Copie para .env e preencha. O .env nunca vai para o git (ver .gitignore).

NODE_ENV=development
PORT=3000
# LOG_LEVEL=info
# Atrás de proxy reverso (Render, Railway...), para o rate limit enxergar o IP real.
TRUST_PROXY=false

# Postgres do Supabase via pooler (session mode, porta 5432). Schema dedicado `tennis`.
# Runtime: papel tennis_api (só DML). Migrations: papel tennis_owner. Ver prisma/sql/papeis.sql.
DATABASE_URL=postgresql://tennis_api.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?schema=tennis&sslmode=require
DIRECT_URL=postgresql://tennis_owner.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?schema=tennis&sslmode=require
# Testes E2E: mesmo banco, schema tennis_test (é apagado a cada execução).
DATABASE_URL_TEST=postgresql://tennis_api.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?schema=tennis_test&sslmode=require
DIRECT_URL_TEST=postgresql://tennis_owner.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?schema=tennis_test&sslmode=require

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<mínimo 32 caracteres aleatórios>
JWT_ACESSO_MIN=15
REFRESH_DIAS=7

# Origens do site/app web autorizadas (separadas por vírgula). O app nativo não envia Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Plataforma mãe. Em demonstração, aponta para o mock embutido nesta mesma API.
PLATAFORMA_MAE_URL=http://localhost:3000/api/v1/mock/plataforma-mae
PLATAFORMA_MAE_API_KEY=<chave aleatória>
MOCK_PLATAFORMA_MAE=true

# Chave mestra que cifra as chaves das raquetes no banco (32 bytes em base64 ou 64 hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_DISPOSITIVOS=<32 bytes em base64>

# Token exigido em GET /api/v1/metrics (Authorization: Bearer <token>).
METRICS_TOKEN=<token aleatório>

# Admin criado pelo seed (npm run db:seed).
ADMIN_EMAIL=admin@tennis-analytics.dev
ADMIN_SENHA=<senha forte, com letras e números>
